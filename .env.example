# ============================================================================
# GamifiedLearning backend — environment
# ============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
GAMRU_PORT=4000
GAMRU_PUBLIC_URL=http://localhost:4000

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=e-learingrace
DB_SSL=false

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GAME_SESSION_SECRET=dev-game-session-secret-change-me

# --- Queue (inline = no Redis needed) ---
QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379

# --- Storage (local disk in dev, served at /uploads) ---
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=learning-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# --- CORS (admin + game frontends) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5273
